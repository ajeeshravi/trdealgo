# --- App ---
APP_NAME=TradeAlgo
ENV=dev
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET=change-me-in-prod-use-a-long-random-string
# base64-encoded 32-byte Fernet key for broker credential encryption (KMS in prod)
CREDENTIALS_ENC_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trade:trade@localhost:5432/trade

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Brokers (defaults; per-user creds stored encrypted in DB) ---
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# --- Market data ---
# Alpaca data keys power the dashboard snapshot/bars feed. Leave blank to run
# without live prices (index cards render "—" until set).
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
DATABENTO_API_KEY=

# --- AI ---
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
